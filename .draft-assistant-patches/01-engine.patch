+    @staticmethod
+    def _to_display_rating(raw_score: float) -> float:
+        """Map unbounded tactical utility to a stable 0-100 adaptive rating.
+
+        The midpoint remains 50.  A 15-point change in raw tactical utility is
+        intentionally meaningful without allowing large multiplicative bonuses
+        or penalties to produce impossible-looking values such as 140 or 250.
+        """
+        try:
+            raw = max(0.0, float(raw_score))
+            x = (raw - 50.0) / 15.0
+
+            # Numerically stable logistic transform.
+            if x >= 0:
+                z = math.exp(-x)
+                rating = 100.0 / (1.0 + z)
+            else:
+                z = math.exp(x)
+                rating = (100.0 * z) / (1.0 + z)
+
+            return max(0.0, min(100.0, rating))
+        except (TypeError, ValueError):
+            return 0.0
