+"""
+src/auto_launch.py
+
+User-level "Open automatically with MTG Arena" support.
+
+The startup hook launches this application with --background at user login.
+Background mode remains UI-less until MTG Arena is detected. No administrator
+privileges are required.
+"""
+
+from __future__ import annotations
+
+import os
+import plistlib
+import shlex
+import subprocess
+import sys
+import time
+from pathlib import Path
+from typing import List, Optional, Tuple
+
+from src.constants import BASE_DIR
+
+MAC_LAUNCH_AGENT_LABEL = "com.mtga-draft-tool.launch-with-arena"
+WINDOWS_RUN_VALUE = "MTGA Draft Tool"
+LINUX_DESKTOP_FILE = "mtga-draft-tool.desktop"
+LOCK_FILE = os.path.join(BASE_DIR, ".app-instance.lock")
+
+
+def launch_command() -> List[str]:
+    """Return the command used by the OS startup hook."""
+    if getattr(sys, "frozen", False):
+        return [sys.executable, "--background"]
+    return [sys.executable, os.path.abspath(sys.argv[0]), "--background"]
+
+
+def set_auto_launch_enabled(enabled: bool) -> Tuple[bool, str]:
+    """Install/remove the current-user startup hook."""
+    try:
+        if sys.platform == "darwin":
+            _set_macos(enabled)
+        elif sys.platform == "win32":
+            _set_windows(enabled)
+        else:
+            _set_linux(enabled)
+        return True, ""
+    except Exception as exc:
+        return False, str(exc)
+
+
+def _set_macos(enabled: bool) -> None:
+    agents = Path.home() / "Library" / "LaunchAgents"
+    plist_path = agents / f"{MAC_LAUNCH_AGENT_LABEL}.plist"
+
+    if not enabled:
+        try:
+            plist_path.unlink()
+        except FileNotFoundError:
+            pass
+        return
+
+    agents.mkdir(parents=True, exist_ok=True)
+    payload = {
+        "Label": MAC_LAUNCH_AGENT_LABEL,
+        "ProgramArguments": launch_command(),
+        "RunAtLoad": True,
+        "ProcessType": "Background",
+        "StandardOutPath": "/dev/null",
+        "StandardErrorPath": "/dev/null",
+    }
+
+    tmp_path = plist_path.with_suffix(".plist.tmp")
+    with open(tmp_path, "wb") as handle:
+        plistlib.dump(payload, handle)
+    os.replace(tmp_path, plist_path)
+
+
+def _set_windows(enabled: bool) -> None:
+    import winreg
+
+    key_path = r"Software\Microsoft\Windows\CurrentVersion\Run"
+    with winreg.OpenKey(
+        winreg.HKEY_CURRENT_USER, key_path, 0, winreg.KEY_SET_VALUE
+    ) as key:
+        if enabled:
+            command = subprocess.list2cmdline(launch_command())
+            winreg.SetValueEx(key, WINDOWS_RUN_VALUE, 0, winreg.REG_SZ, command)
+        else:
+            try:
+                winreg.DeleteValue(key, WINDOWS_RUN_VALUE)
+            except FileNotFoundError:
+                pass
+
+
+def _set_linux(enabled: bool) -> None:
+    autostart = Path.home() / ".config" / "autostart"
+    desktop_path = autostart / LINUX_DESKTOP_FILE
+
+    if not enabled:
+        try:
+            desktop_path.unlink()
+        except FileNotFoundError:
+            pass
+        return
+
+    autostart.mkdir(parents=True, exist_ok=True)
+    command = " ".join(shlex.quote(part) for part in launch_command())
+    desktop = (
+        "[Desktop Entry]\n"
+        "Type=Application\n"
+        "Name=MTGA Draft Tool\n"
+        f"Exec={command}\n"
+        "Terminal=false\n"
+        "X-GNOME-Autostart-enabled=true\n"
+    )
+    tmp_path = desktop_path.with_suffix(".desktop.tmp")
+    tmp_path.write_text(desktop, encoding="utf-8")
+    os.replace(tmp_path, desktop_path)
+
+
+def is_arena_running(log_path: str = "") -> bool:
+    """Best-effort, dependency-free MTG Arena process detection."""
+    try:
+        if sys.platform == "win32":
+            creationflags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
+            result = subprocess.run(
+                ["tasklist", "/FI", "IMAGENAME eq MTGA.exe", "/NH"],
+                capture_output=True,
+                text=True,
+                timeout=2,
+                creationflags=creationflags,
+            )
+            if "MTGA.exe" in result.stdout:
+                return True
+        else:
+            # Covers native macOS MTGA plus Wine/Proton MTGA.exe on Linux.
+            result = subprocess.run(
+                ["pgrep", "-f", r"(^|/)(MTGA|MTGA\.exe)( |$)|MTGA\.app"],
+                capture_output=True,
+                text=True,
+                timeout=2,
+            )
+            if result.returncode == 0 and result.stdout.strip():
+                return True
+    except (OSError, subprocess.SubprocessError):
+        pass
+
+    # Fallback: Arena rewrites/touches Player.log during startup. This mainly
+    # helps unusual installations whose process name differs from the defaults.
+    if log_path:
+        try:
+            return (time.time() - os.path.getmtime(log_path)) < 15.0
+        except OSError:
+            pass
+
+    return False
+
+
+def wait_for_arena(log_path: str = "", poll_seconds: float = 2.0) -> None:
+    """Block cheaply until MTG Arena is running."""
+    while not is_arena_running(log_path):
+        time.sleep(poll_seconds)
+
+
+class InstanceLock:
+    """Cross-platform process lock released automatically when the process exits."""
+
+    def __init__(self, path: str = LOCK_FILE):
+        self.path = path
+        self.handle = None
+
+    def acquire(self) -> bool:
+        os.makedirs(os.path.dirname(self.path), exist_ok=True)
+        self.handle = open(self.path, "a+b")
+        try:
+            if sys.platform == "win32":
+                import msvcrt
+
+                self.handle.seek(0)
+                if self.handle.tell() == 0:
+                    self.handle.write(b"0")
+                    self.handle.flush()
+                self.handle.seek(0)
+                msvcrt.locking(self.handle.fileno(), msvcrt.LK_NBLCK, 1)
+            else:
+                import fcntl
+
+                fcntl.flock(self.handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+            return True
+        except (OSError, IOError):
+            self.release()
+            return False
+
+    def release(self) -> None:
+        if not self.handle:
+            return
+        try:
+            if sys.platform == "win32":
+                import msvcrt
+
+                self.handle.seek(0)
+                msvcrt.locking(self.handle.fileno(), msvcrt.LK_UNLCK, 1)
+            else:
+                import fcntl
+
+                fcntl.flock(self.handle.fileno(), fcntl.LOCK_UN)
+        except (OSError, IOError):
+            pass
+        try:
+            self.handle.close()
+        finally:
+            self.handle = None
+
+
+class ArenaPresenceMonitor:
+    """Tk-safe process monitor used after the full application is running."""
+
+    def __init__(
+        self,
+        root,
+        log_path_provider,
+        on_started,
+        on_stopped,
+        poll_ms: int = 2000,
+    ):
+        self.root = root
+        self.log_path_provider = log_path_provider
+        self.on_started = on_started
+        self.on_stopped = on_stopped
+        self.poll_ms = poll_ms
+        self._last_state: Optional[bool] = None
+        self._job = None
+        self._running = False
+
+    def start(self) -> None:
+        if self._running:
+            return
+        self._running = True
+        self._poll()
+
+    def stop(self) -> None:
+        self._running = False
+        if self._job is not None:
+            try:
+                self.root.after_cancel(self._job)
+            except Exception:
+                pass
+            self._job = None
+
+    def _poll(self) -> None:
+        if not self._running:
+            return
+        try:
+            path = self.log_path_provider() or ""
+            state = is_arena_running(path)
+            if self._last_state is None:
+                self._last_state = state
+                if state:
+                    self.on_started()
+            elif state != self._last_state:
+                self._last_state = state
+                if state:
+                    self.on_started()
+                else:
+                    self.on_stopped()
+        finally:
+            if self._running:
+                self._job = self.root.after(self.poll_ms, self._poll)
