diff --git a/tests/test_auto_launch.py b/tests/test_auto_launch.py
new file mode 100644
--- /dev/null
+++ b/tests/test_auto_launch.py
@@
+import plistlib
+from unittest.mock import MagicMock
+
+import src.auto_launch as auto_launch
+
+
+def test_macos_registration_writes_background_launch_agent(tmp_path, monkeypatch):
+    monkeypatch.setattr(auto_launch.sys, "platform", "darwin")
+    monkeypatch.setattr(auto_launch.Path, "home", classmethod(lambda cls: tmp_path))
+    monkeypatch.setattr(auto_launch, "launch_command", lambda: ["/Applications/Test", "--background"])
+
+    ok, error = auto_launch.set_auto_launch_enabled(True)
+    assert ok, error
+
+    plist_path = (
+        tmp_path
+        / "Library"
+        / "LaunchAgents"
+        / f"{auto_launch.MAC_LAUNCH_AGENT_LABEL}.plist"
+    )
+    assert plist_path.exists()
+    with open(plist_path, "rb") as handle:
+        payload = plistlib.load(handle)
+
+    assert payload["RunAtLoad"] is True
+    assert payload["ProgramArguments"][-1] == "--background"
+
+
+def test_linux_registration_writes_autostart_file(tmp_path, monkeypatch):
+    monkeypatch.setattr(auto_launch.sys, "platform", "linux")
+    monkeypatch.setattr(auto_launch.Path, "home", classmethod(lambda cls: tmp_path))
+    monkeypatch.setattr(auto_launch, "launch_command", lambda: ["/opt/MTGA Draft Tool", "--background"])
+
+    ok, error = auto_launch.set_auto_launch_enabled(True)
+    assert ok, error
+
+    desktop = tmp_path / ".config" / "autostart" / auto_launch.LINUX_DESKTOP_FILE
+    text = desktop.read_text(encoding="utf-8")
+    assert "--background" in text
+    assert "Terminal=false" in text
+
+
+def test_disable_removes_macos_registration(tmp_path, monkeypatch):
+    monkeypatch.setattr(auto_launch.sys, "platform", "darwin")
+    monkeypatch.setattr(auto_launch.Path, "home", classmethod(lambda cls: tmp_path))
+    monkeypatch.setattr(auto_launch, "launch_command", lambda: ["/Applications/Test", "--background"])
+
+    assert auto_launch.set_auto_launch_enabled(True)[0]
+    assert auto_launch.set_auto_launch_enabled(False)[0]
+
+    plist_path = (
+        tmp_path
+        / "Library"
+        / "LaunchAgents"
+        / f"{auto_launch.MAC_LAUNCH_AGENT_LABEL}.plist"
+    )
+    assert not plist_path.exists()
+
+
+def test_process_detection_accepts_mtga_pgrep(monkeypatch):
+    monkeypatch.setattr(auto_launch.sys, "platform", "darwin")
+    fake = MagicMock(returncode=0, stdout="1234\n")
+    monkeypatch.setattr(auto_launch.subprocess, "run", lambda *a, **k: fake)
+    assert auto_launch.is_arena_running("") is True
